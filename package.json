    "buffer": "6.0.3",
    "drizzle-orm": "0.44.5",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-dev-client": "57.0.19",
    "expo-haptics": "57.0.3",
    "expo-keep-awake": "57.0.2",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.23",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
